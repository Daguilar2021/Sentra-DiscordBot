# Sentra-DiscordBot Environment Variables Configuration

# Discord Bot Credentials
BOT_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here

# OAuth Redirect URI
#PORT=5000
REDIRECT_URI=https://<YOUR-CLOUDFLARE-TUNNEL-URL>/callback
CONNECTION_STRINGS= your_database_host_here;Database=your_database_name_here;Username=your_database_user_here;Password=your_database_password_here;SSL Mode=Require;Trust Server Certificate=true

# Database Connection String
DATABASE_URL=postgresql://<user:password>@localhost:5432/<your Database Name>
