{
  "buildCommand": "npm run build",
    "rewrites": [
    {
      "source": "^/$",
      "destination": "/index.html"
    },
    {
      "source": "^/documentation$",
      "destination": "/index.html"
    },
    {
      "source": "^/auth/success$",
      "destination": "/index.html"
    },
    {
      "source": "^/(.*)$",
      "destination": "/index.html"
    }
  ]
}