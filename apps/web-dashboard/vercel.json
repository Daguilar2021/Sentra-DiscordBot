{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/web-dashboard/browser",
  "cleanUrls": true,
  "trailingSlash": false,
    "routes": [
    {
      "src": "^/$",
      "dest": "/index.html"
    },
    {
      "src": "^/documentation$",
      "dest": "/index.html"
    },
    {
      "src": "^/auth/success$",
      "dest": "/index.html"
    },
    {
      "src": "^/(.*)$",
      "dest": "/index.html"
    }
  ]
}