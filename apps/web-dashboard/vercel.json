{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/web-dashboard/browser",
  "cleanUrls": true,
  "trailingSlash": false,
    "rewrites": [
    {
      "source": "^/$",
      "destination": "/index.html"
    },
    {
      "source": "^/documentation$",
      "destination": "/index.html"
    },
    {
      "source": "^/auth/success$",
      "destination": "/index.html"
    },
    {
      "source": "^/(.*)$",
      "destination": "/index.html"
    }
  ]
}